# Imagen de HAPI FHIR. Fija una versión concreta en lugar de "latest"
HAPI_IMAGE=hapiproject/hapi:latest

# Puerto del equipo desde el que se accede a fhir-service
FHIR_PORT=puerto_del_equipo

# Base de datos de fhir-service
FHIR_DB_NAME=hapi
FHIR_DB_USER=aqui el usuario de la base de datos
FHIR_DB_PASSWORD=aqui la contraseña de la base de datos
