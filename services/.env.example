# Copia este archivo como .env y ajusta los valores (el .env NO se sube al repositorio).
# Los valores de abajo son de ejemplo, no son credenciales reales.

# --- Puertos publicados en el equipo ---
FHIR_PORT=8090
GESTION_PACIENTES_PORT=8081
INGESTA_PORT=8082
AZURITE_BLOB_PORT=11000
AZURITE_QUEUE_PORT=11001
AZURITE_TABLE_PORT=11002

# --- fhir-service (HAPI FHIR) y su base de datos PostgreSQL ---
HAPI_IMAGE=hapiproject/hapi:latest
FHIR_DB_NAME=hapi
FHIR_DB_USER=hapi_user
FHIR_DB_PASSWORD=cambia-esta-contrasena

# --- Clave maestra de las Azure Functions (header x-functions-key) ---
FUNCTIONS_MASTER_KEY=cambia-esta-clave-larga

# --- Azurite (emulador de colas). Es la cuenta pública de desarrollo de Microsoft ---
AZURITE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# --- servicio-alertas: SMTP de Gmail (contraseña de aplicación de 16 letras) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion
